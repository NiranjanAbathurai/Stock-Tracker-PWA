SUPABASE_SERVICE_SECRET_KEY=your_service_role_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your@email.com

# ─── EmailJS Configuration (for expiry notification emails) ───
EMAILJS_SERVICE_ID=service_jzegqtm
EMAILJS_TEMPLATE_ID=template_z4ips6l
EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_here

# ─── Gemini AI Keys (Multi-key fallback) ───
# Primary key: Your Jio Gemini Pro subscription key (tried first)
GEMINI_API_KEY_PRIMARY=your_jio_gemini_pro_key_here
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
# GEMINI_BASE_URL_PRIMARY=https://generativelanguage.googleapis.com/v1beta

# Fallback key: Free Google AI Studio key (used when primary is exhausted)
GEMINI_API_KEY_FALLBACK=your_free_google_ai_studio_key_here
GEMINI_MODEL_FALLBACK=gemini-2.0-flash
# GEMINI_BASE_URL_FALLBACK=https://generativelanguage.googleapis.com/v1beta

# Legacy single-key (still works if you only have one key)
# GEMINI_API_KEY=your_single_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ─── Groq AI (PRIMARY for voice + text commands) ───
# Get free key from: https://console.groq.com/
# Free tier: 30 req/min, 14,400 req/day, 28,800 audio-seconds/day
# Voice flow: Groq Whisper (STT) → Groq LLM (command processing)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo


# ─── App Configuration ───
# Your deployed app URL (used for CORS restriction)
APP_URL=https://stock-tracker-app-ai.netlify.app
